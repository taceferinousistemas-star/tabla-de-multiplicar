# Multiplicación de dos matrices

A = []
B = []

print("Ingrese los números de la matriz A")

for i in range(2):
    fila = []
    for j in range(2):
        fila.append(int(input(f"A[{i}][{j}]: ")))
    A.append(fila)

print("\nIngrese los números de la matriz B")

for i in range(2):
    fila = []
    for j in range(2):
        fila.append(int(input(f"B[{i}][{j}]: ")))
    B.append(fila)

# Multiplicación
C = [
    [A[0][0]*B[0][0] + A[0][1]*B[1][0],
     A[0][0]*B[0][1] + A[0][1]*B[1][1]],

    [A[1][0]*B[0][0] + A[1][1]*B[1][0],
     A[1][0]*B[0][1] + A[1][1]*B[1][1]]
]

print("\nMatriz A:", A)
print("Matriz B:", B)
print("Resultado:", C)